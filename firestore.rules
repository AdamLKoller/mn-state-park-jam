rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /friendships/{id} {
      allow read: if signedIn() && (resource.data.emailA == email() || resource.data.emailB == email());
      allow create: if signedIn()
                    && request.resource.data.emailA is string
                    && request.resource.data.emailB is string
                    && (request.resource.data.emailA == email() || request.resource.data.emailB == email());
      allow update, delete: if signedIn() && (resource.data.emailA == email() || resource.data.emailB == email());
    }

    match /trips/{tripId} {
      allow read: if signedIn() && email() in resource.data.memberEmails;
      allow create: if signedIn() && email() in request.resource.data.memberEmails;
      allow update: if signedIn()
                    && email() in resource.data.memberEmails
                    && email() in request.resource.data.memberEmails;
      allow delete: if signedIn() && resource.data.creatorEmail == email();
    }
  }
}
